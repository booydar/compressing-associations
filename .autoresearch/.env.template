# Copy this file to .autoresearch/.env and fill in your keys.
# Lines starting with # are ignored.

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
OPENAI_API_KEY=sk-...

# Local providers (LMStudio / llama.cpp) and cursor-openai-bridge do not need
# real API keys. The value is passed as the Authorization header but is ignored.
# You can omit these entirely — llm_client.py defaults to "no-key" if unset.
LMSTUDIO_API_KEY=lm-studio
LLAMACPP_API_KEY=no-key
